#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
project_root="$(cd "$script_dir/.." && pwd)"

# Capture before any cd: this is what tells us whether the caller invoked
# `diotima` from inside a grove.
orig_cwd="$(pwd)"

single_grove=0
if [ -f "$orig_cwd/DAFNE.md" ]; then
    dir="$orig_cwd"
    single_grove=1
elif [ -n "${DIOTIMA_GARDEN:-}" ]; then
    dir="$DIOTIMA_GARDEN"
else
    default_garden="$(python3 -c "
import json
print(json.load(open('$project_root/system/diotima/config.json'))['default_garden'])
")"
    dir="${default_garden/#\~/$HOME}"
fi
mkdir -p "$dir"

# Runs in a child process: this cd never propagates back to the caller's
# shell, so no state needs saving to "return" the caller to their own cwd.
# Claude Code only loads a project's .claude/settings.json (permissions,
# hooks) when cwd is exactly that project's root -- master must stay cwd
# for the session's tooling to be there, regardless of which grove or
# garden the session's subject is.
cd "$project_root"

args=()
plugins_dir="$project_root/plugins"
if [ -d "$plugins_dir" ]; then
    for d in "$plugins_dir"/*/; do
        [ -d "${d}.claude-plugin" ] && args+=("--plugin-dir" "${d%/}")
    done
fi
args+=("--add-dir" "$dir")

# Grove sync runs here, before exec, and never inside the session: the
# mutation therefore happens outside any Claude Code session, which is why
# it needs no allow rule in .claude/settings.json (security.md's ban on
# whitelisting mutating git commands is about in-session calls, and the
# moment this CLI is invoked from inside one it stays prompted like any
# other). DIOTIMA_GARDEN must be prefixed explicitly -- $dir is a plain
# shell var here, so without it grove_sync resolves scope from the
# caller's own environment and would sync the whole garden when launched
# from inside a single grove. `|| true` because of set -euo pipefail: a
# grove that cannot sync must never fail a launch.
DIOTIMA_GARDEN="$dir" python3 "$project_root/system/diotima/grove_sync.py" || true

# Single-grove mode only. A session whose subject is one grove is work
# *inside* that grove, and some groves are drills -- the input field's
# Tab-accept ghost text would hand the practitioner a decent answer to the
# very scenario they are there to answer themselves. Garden-wide sessions
# are orchestration, not practice, and keep the suggestions. Exported
# rather than prefixed on the exec line below only because the assignment
# is conditional -- the script execs immediately after either way, so it
# reaches the same one process. The env var is read before any settings
# file, so this wins regardless of user config.
#
# Blanket across all groves for now: the grove that actually knows whether
# it is a drill has no way to say so until the DAFNE.md header can carry
# it -- diotima-garden/dafne#1. Drop this in favour of the manifest once
# that lands.
if [ "$single_grove" -eq 1 ]; then
    export CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=false
fi

# DIOTIMA_GARDEN reused here as "the one directory this session's
# SessionStart hook should look at" -- a grove if orig_cwd was one, else
# the garden. Scoped to the exec'd process only; never touches the
# caller's own DIOTIMA_GARDEN, if they have one set in their shell.
DIOTIMA_GARDEN="$dir" exec claude "${args[@]}" "$@"
