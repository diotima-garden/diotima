#!/usr/bin/env bash
#
# A shim. The launcher's body lives in system/diotima/launch.py -- it had
# stopped being glue (subject resolution, two permission-bearing paths, grove
# sync, the prompt-suggestion decision) and bash gave it no way to be tested.
# Everything this script knows is where that file is.
#
# exec, so launch.py's own exec of claude replaces this process rather than
# nesting under it: one process, so Ctrl-C, the TTY and the exit code behave
# as if the caller had run claude themselves.
set -euo pipefail

script_dir="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
exec python3 "$script_dir/../system/diotima/launch.py" "$@"
